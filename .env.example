DATABASE_URL=postgres://postgres:<MY_PASSWORD>@localhost:5432/hajr_live?sslmode=disable
# Use a long random value in real environments, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_secret
PORT=8080
# DEV ONLY: set to true to let /api/login issue a JWT for any existing phone number (no OTP check)
MOCK_LOGIN_ENABLED=false
# Optional: comma-separated browser origins allowed to open /ws (empty = same-origin only)
WS_ALLOWED_ORIGINS=
